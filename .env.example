# ══════════════════════════════════════════════
# Telegram Bot Configuration
# ══════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated allowed Telegram user IDs.
# Tip: Leave empty on first run, start the bot, and send /start to discover your ID!
ALLOWED_USER_IDS=123456789

# ══════════════════════════════════════════════
# Antigravity CLI & Workspace (optional — auto-detected if omitted)
# ══════════════════════════════════════════════
# Defaults to PATH / ~/.local/bin/agy on host, or /root/.local/bin/agy in Docker:
# AGY_PATH=/root/.local/bin/agy
#
# Defaults to ~/my-project on host, or /root/workspace in Docker:
# DEFAULT_WORKSPACE=/root/workspace

# ══════════════════════════════════════════════
# Authentication (choose one)
# ══════════════════════════════════════════════
# Option 1: Gemini API Key (headless — only Gemini models available, recommended for Docker, but useless if you don't pay for tokens there)
# GEMINI_API_KEY=your_gemini_api_key_here
#
# Option 2: OAuth token from host (required for Claude & GPT models, mount via docker-compose volumes)
# Uncomment the volume line in docker-compose.yml:
#   - ~/.gemini/antigravity-cli/antigravity-oauth-token:/root/.gemini/antigravity-cli/antigravity-oauth-token:ro

# ══════════════════════════════════════════════
# Proxy (optional — routes all agy API requests through proxy)
# ══════════════════════════════════════════════
# HTTP_PROXY=http://172.19.96.1:10808
# HTTPS_PROXY=http://172.19.96.1:10808
# NO_PROXY=localhost,127.0.0.1,::1
