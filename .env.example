# ══════════════════════════════════════════════
# Telegram Bot Configuration
# ══════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_USER_IDS=123456789

# ══════════════════════════════════════════════
# Antigravity CLI
# ══════════════════════════════════════════════
AGY_PATH=/root/.local/bin/agy
DEFAULT_WORKSPACE=/root/workspace

# ══════════════════════════════════════════════
# Authentication (choose one)
# ══════════════════════════════════════════════
# Option 1: Gemini API Key (headless — recommended for Docker)
# GEMINI_API_KEY=your_gemini_api_key_here
#
# Option 2: OAuth token from host (mount via docker-compose volumes)
# Uncomment the volume line in docker-compose.yml:
#   - ~/.gemini/antigravity-cli/antigravity-oauth-token:/root/.gemini/antigravity-cli/antigravity-oauth-token:ro

# ══════════════════════════════════════════════
# Proxy (optional — routes all agy API requests through proxy)
# ══════════════════════════════════════════════
# HTTP_PROXY=http://172.19.96.1:10808
# HTTPS_PROXY=http://172.19.96.1:10808
# NO_PROXY=localhost,127.0.0.1,::1
